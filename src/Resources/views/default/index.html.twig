{% extends "@NovosgaAttendance/base.html.twig" %}

{% trans_default_domain 'NovosgaAttendanceBundle' %}

{% block body %}
    <div id="attendance" v-cloak data-base-url="{{ path('novosga_attendance_index') }}">
        <div class="d-flex align-items-center">
            <div>
                <h1>
                    <i class="fa fa-pencil-square-o" aria-hidden="true"></i>
                    {{ 'title'|trans }}
                </h1>
            </div>
            <div class="ms-auto">
                <a href="#dialog-busca" class="btn btn-outline-secondary" data-bs-toggle="modal">
                    <i class="fa fa-search me-1"></i>
                    {{ 'button.find_ticket'|trans }}
                </a>
                <a href="#dialog-atendimento-config" class="btn btn-outline-secondary" data-bs-toggle="modal">
                    <i class="fa fa-cog me-1"></i>
                    {{ 'label.configuration'|trans }}
                </a>
            </div>
        </div>
        <div id="atendimento" v-if="usuario.numeroLocal && usuario.local" class="py-3">
            <div class="top">
                <div class="row">
                    <div class="col-12 col-md-2">
                        <div id="local" class="card">
                            <a href="#dialog-local" data-bs-toggle="modal">
                                <i class="fa fa-cog"></i>
                            </a>
                            <div class="local" v-text="usuario.local.nome">
                                {{ local }}
                            </div>
                            <div class="numero" v-text="usuario.numeroLocal">
                                {{ numeroLocal }}
                            </div>
                            <div class="tipo-atendimento" v-bind:class="'tipo-' + usuario.tipoAtendimento">
                                <span>
                                    {% verbatim %}
                                        {{ tiposAtendimento[usuario.tipoAtendimento] }}
                                    {% endverbatim %}
                                </span>
                            </div>
                            <hr>
                            <div class="user d-flex">
                                <i class="fa fa-user my-2 mx-3"></i>
                                <div>
                                    <span class="name">{{app.user.nomeCompleto}}</span>
                                    <span class="username">{{app.user.userIdentifier}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-10 ps-3">
                        <div class="attendance-panel">
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-5 controls">
                                <div class="col d-grid">
                                    <button type="button"
                                            class="btn btn-primary"
                                            title="{{ 'button.call_next'|trans }}"
                                            v-bind:disabled="busy || total === 0 || (atendimento && (atendimento.status !== 'chamado'))"
                                            v-on:click="chamar">
                                        <i class="fa fa-bullhorn"></i>
                                        <span v-if="atendimento">{{ 'button.call_again'|trans }}</span>
                                        <span v-else>{{ 'button.call_next'|trans }}</span>
                                    </button>
                                </div>
                                <div class="col d-grid">
                                    <button type="button"
                                            class="btn btn-success btn-control iniciar"
                                            title="{{ 'button.start'|trans }}"
                                            v-bind:disabled="busy || !atendimento || (atendimento && atendimento.status !== 'chamado')"
                                            v-on:click="iniciar">
                                        <i class="fa fa-play"></i>
                                        <span>{{ 'button.start'|trans }}</span>
                                    </button>
                                </div>
                                <div class="col d-grid">
                                    <button type="button"
                                            class="btn btn-primary"
                                            title="{{ 'button.finish'|trans }}"
                                            v-bind:disabled="busy || !atendimento || (atendimento && atendimento.status !== 'iniciado')"
                                            v-on:click="preparaEncerrar">
                                        <i class="fa fa-stop"></i>
                                        <span>{{ 'button.finish'|trans }}</span>
                                    </button>
                                </div>
                                <div class="col d-grid">
                                    <button type="button"
                                            class="btn btn-danger"
                                            title="{{ 'button.not_show'|trans }}"
                                            v-bind:disabled="busy || !atendimento || (atendimento && atendimento.status !== 'chamado')"
                                            v-on:click="naoCompareceu">
                                        <i class="fa fa-user-times"></i>
                                        <span>{{ 'button.not_show'|trans }}</span>
                                    </button>
                                </div>
                                <div class="col d-grid">
                                    <button type="button"
                                            class="btn btn-warning"
                                            title="{{ 'button.error'|trans }}"
                                            v-bind:disabled="busy || !atendimento || (atendimento && atendimento.status !== 'iniciado')"
                                            v-on:click="erroTriagem">
                                        <i class="fa fa-exclamation-triangle"></i>
                                        <span>{{ 'button.error'|trans }}</span>
                                    </button>
                                </div>
                            </div>

                            <div v-if="!atendimento" class="text-center text-muted my-3 py-5 border rounded">
                                <i class="fa fa-bullhorn fa-2x d-block mb-2"></i>
                                <p class="mb-2">
                                    <b>{{ 'label.no_current_attendance'|trans }}</b><br>
                                    {{ 'label.call_to_start'|trans }}
                                </p>
                            </div>

                            <div v-if="atendimento" class="card my-3 px-3 ticket-info" :style="{ 'border-color': atendimento.prioridade.cor }">
                                <div class="d-flex justify-content-between py-3">
                                    <div class="d-flex align-items-center">
                                        <h4 title="{{ 'label.ticket'|trans }}" class="ticket" :style="{ 'color': atendimento.prioridade.cor }">
                                            {%- verbatim -%}
                                                {{ atendimento.senha.format }}
                                            {%- endverbatim -%}
                                        </h4>
                                        <span title="{{ 'label.service'|trans }}" class="service">
                                            {%- verbatim -%}
                                                {{ atendimento.servico.nome }}
                                            {%- endverbatim -%}
                                        </span>
                                    </div>
                                    <div>
                                        <span title="{{ 'label.ticket.wait_time'|trans }}" class="badge rounded-pill text-bg-light">
                                            <i class="fa fa-clock-o me-2"></i>
                                            {%- verbatim -%}
                                                {{ atendimento.tempoEspera }}
                                            {%- endverbatim -%}
                                        </span>
                                        <span title="{{ 'label.priority'|trans }}" :style="{ backgroundColor: atendimento.prioridade.cor }" class="priority badge rounded-pill">
                                            {%- verbatim -%}
                                                {{ atendimento.prioridade.nome }}
                                            {%- endverbatim -%}
                                        </span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <div class="mb-3">
                                            <label>{{ 'label.customer.name'|trans }}</label>
                                            <input type="text" class="form-control" :value="atendimento.cliente?.nome" disabled>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="mb-3">
                                            <label>{{ 'label.customer.id'|trans }}</label>
                                            <input type="text" class="form-control" :value="atendimento.cliente?.documento" disabled>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="mb-3">
                                            <label>{{ 'label.customer.email'|trans }}</label>
                                            <input type="text" class="form-control" :value="atendimento.cliente?.email" disabled>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="mb-3">
                                            <label>{{ 'label.customer.phone'|trans }}</label>
                                            <input type="text" class="form-control" :value="atendimento.cliente?.telefone" disabled>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end pb-3">
                                    <button
                                        :disabled="atendimento.status === 'chamado'"
                                        type="button"
                                        class="btn btn-outline-secondary"
                                        data-bs-target="#dialog-customer"
                                        data-bs-toggle="modal">
                                        <i class="fa fa-edit me-1"></i>
                                        {{ 'button.edit'|trans }}
                                    </button>
                                </div>
                            </div>

                            <div class="row" v-if="atendimento && atendimento.status==='encerrando'">
                                <div class="card-group">
                                    <div class="card">
                                        <div class="card-header">
                                            {{ 'label.services.available'|trans }}
                                        </div>
                                        <div class="card-body" v-if="servicosUsuario.length===0">
                                            <p class="text-muted">
                                                {{ 'label.services.available.empty'|trans }}
                                            </p>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item"
                                                v-for="su in servicosUsuario"
                                                v-if="servicosRealizados.indexOf(su.servico)===-1">
                                                <span v-if="su.subServicos.length">
                                                    {%- verbatim -%}
                                                        {{ su.servico.nome }}
                                                    {%- endverbatim -%}
                                                </span>
                                                <ul v-if="su.subServicos.length">
                                                    <li v-for="sub in su.subServicos" v-if="sub.disabled!==true">
                                                        <a href="#" title="{{ 'button.add'|trans }}" v-on:click.prevent="addServicoRealizado(sub)">
                                                            <i class="fa fa-plus me-2"></i>
                                                            {%- verbatim -%}
                                                                {{ sub.nome }}
                                                            {%- endverbatim -%}
                                                        </a>
                                                    </li>
                                                </ul>
                                                <a href="#" title="{{ 'button.add'|trans }}" v-if="su.subServicos.length===0" v-on:click.prevent="addServicoRealizado(su.servico)">
                                                    <i class="fa fa-plus me-2"></i>
                                                    {%- verbatim -%}
                                                        {{ su.servico.nome }}
                                                    {%- endverbatim -%}
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="card">
                                        <div class="card-header">
                                            {{ 'label.services.executed'|trans }}
                                        </div>
                                        <div class="card-body" v-if="servicosRealizados.length===0">
                                            <p class="text-muted">
                                                {{ 'label.services.executed.empty'|trans }}
                                            </p>
                                        </div>
                                        <ul class="list-group list-group-flush servicos-realizados">
                                            <li class="list-group-item" v-for="servico in servicosRealizados">
                                                <a href="#" title="{{ 'label.remove'|trans }}" v-on:click.prevent="removeServicoRealizado(servico)">
                                                    <i class="fa fa-minus me-2"></i>
                                                    {% verbatim %}
                                                        {{ servico.nome }}
                                                    {% endverbatim %}
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="card">
                                        <div class="card-header">
                                            {{ 'label.resolution'|trans }}
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <label for="resolucao">{{ 'label.resolution'|trans }}</label>
                                                <select id="resolucao" class="form-control" v-model="atendimento.resolucao">
                                                    <option value="resolvido">{{ 'label.resolution_solved'|trans }}</option>
                                                    <option value="resolvido_parcialmente">{{ 'label.resolution_solved_partially'|trans }}</option>
                                                    <option value="pendente">{{ 'label.resolution_pending'|trans }}</option>
                                                    <option value="encaminhado">{{ 'label.resolution_forwarded'|trans }}</option>
                                                    <option value="nao_resolvido">{{ 'label.resolution_not_solved'|trans }}</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label for="observacao">{{ 'label.notes'|trans }}</label>
                                                <textarea id="observacao" class="form-control" v-model="atendimento.observacao" rows="8"></textarea>
                                            </div>
                                            <div class="form-check">
                                                <input id="redirecionar-check" class="form-check-input" type="checkbox" v-model="redirecionarAoEncerrar">
                                                <label class="form-check-label" for="redirecionar-check">
                                                    {{ 'label.redirect_attendance'|trans }}
                                                </label>
                                            </div>


                                        </div>
                                        <div class="card-footer">
                                            <div class="d-flex justify-content-between">
                                                <button type="button"
                                                        class="btn btn-primary"
                                                        title="{{ 'button.finish'|trans }}"
                                                        v-bind:disabled="busy"
                                                        v-on:click="encerrar(false)">
                                                    <i class="fa fa-stop"></i>
                                                    <span>{{ 'button.finish'|trans }}</span>
                                                </button>
                                                <button type="button"
                                                        class="btn"
                                                        title="{{ 'button.redirect'|trans }}"
                                                        v-bind:disabled="busy"
                                                        v-on:click="encerrarVoltar">
                                                    <i class="fa fa-chevron-left"></i>
                                                    <span>{{ 'button.back'|trans }}</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bottom">
                <h6>{{ 'label.waiting_queues'|trans }}</h6>
                <div :class="queuesStyleClass()">
                    <div v-for="fila in filas" v-if="showQueue(fila)" :class="queueOuterStyleClass(fila)">
                        <div :class="queueInnerStyleClass(fila)">
                            <div class="card-header">
                                <span v-if="fila.servico">
                                    {% verbatim %}
                                        {{fila.servico.servico.nome}}
                                    {% endverbatim %}
                                </span>
                                <span v-else>
                                    {{ 'label.all_services'|trans }}
                                </span>
                                <span class="badge badge-pill bg-secondary float-end">
                                    {% verbatim %}
                                        {{fila.atendimentos.length}}
                                    {% endverbatim %}
                                </span>
                            </div>
                            <div class="card-body">
                                <ul>
                                    <li>
                                        <button class="btn btn-outline-primary"
                                            title="{{ 'button.call_next'|trans }}"
                                            v-bind:disabled="busy || fila.atendimentos.length===0 || atendimento"
                                            v-on:click="chamar"
                                            v-if="!fila.servico">
                                            <i class="fa fa-bullhorn"></i>
                                            {{ 'button.call'|trans }}
                                        </button>
                                        {% if settings.callTicketByService %}
                                            <button class="btn btn-outline-primary"
                                                title="{{ 'button.call_next'|trans }}"
                                                v-bind:disabled="busy || fila.atendimentos.length===0 || atendimento"
                                                v-on:click="chamarServico(fila.servico.servico)"
                                                v-if="fila.servico">
                                                <i class="fa fa-bullhorn"></i>
                                                {{ 'button.call'|trans }}
                                            </button>
                                        {% endif %}
                                    </li>
                                    <li v-for="(atendimento, index) in fila.atendimentos">
                                        <a href="#"
                                        v-bind:class="{ prioridade: atendimento.prioridade.peso, proximo: index===0 }"
                                        v-bind:style="getItemFilaStyle(atendimento)"
                                        v-on:click.prevent="infoSenha(atendimento)"
                                        v-bind:title="atendimento.servico.nome + ' (' + atendimento.tempoEspera + ')'">
                                            {%- verbatim -%}
                                                <span>{{ getAtendimentoLabel(atendimento) }}</span>
                                            {%- endverbatim -%}
                                        </a>
                                    </li>
                                    <li class="empty" v-if="fila.atendimentos.length===0">
                                        {{ 'label.my_queue.empty'|trans }}
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="dialog-local" ref="localModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form v-on:submit.prevent="setLocal">
                        <div class="modal-header">
                            <h5 class="modal-title">{{ 'modal.place'|trans }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="mb-3">
                                        <label class="control-label">{{ 'label.place.number'|trans }}</label>
                                        <input type="number" maxlength="3" class="form-control" v-model.number="novoLocal.numeroLocal" required>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="mb-3">
                                        <label class="control-label">{{ 'label.attendance.type'|trans }}</label>
                                        <select class="form-control" v-model="novoLocal.tipoAtendimento" required :disabled="!settings.changeTicketType">
                                            {% for v,l in tiposAtendimento %}
                                                <option value="{{ v }}" {% if tipoAtendimento == v %}selected="selected"{% endif %}>{{ l }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="mb-3">
                                        <label class="control-label">{{ 'label.place'|trans }}</label>
                                        <select class="form-control" v-model="novoLocal.local" required>
                                            {% for l in locais %}
                                                <option :value="{{ l.id }}" {% if local and local.id == l.id %}selected="selected"{% endif %}>{{ l.nome }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">
                                {{ 'button.save'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div ref="customerModal" id="dialog-customer" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form
                        v-on:submit.prevent="saveCustomer">
                        <div class="modal-header">
                            <h5 class="modal-title">{{ 'modal.customer'|trans }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">
                                {{ 'button.save'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {# dialog redirecionar #}
        <div ref="redirecionarModal" id="dialog-redirecionar" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content" v-if="atendimento">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'modal.redirect'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label>{{ 'label.redirect.new_service'|trans }}</label>
                            <select class="form-control" v-model="servicoRedirecionar" v-on:change="changeServicoRedirecionar">
                                <option value="">{{ 'label.choose'|trans }}</option>
                                {% for su in servicosIndisponiveis %}
                                    <option :value="{{ su.servico.id }}">{{ su.servico.nome }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>{{ 'label.redirect.new_user'|trans }}</label>
                            <select class="form-control" v-model="novoUsuario">
                                <option v-bind:value="u.id" v-for="u in usuarios">
                                    {% verbatim %}{{ u.nome }} {{ u.sobrenome }}{% endverbatim %}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary"
                                v-on:click="redirecionar()"
                                v-if="atendimento.status !== 'encerrando'">
                            {{ 'modal.redirect.button.redirect'|trans }}
                        </button>

                        <button type="button" class="btn btn-primary"
                                v-on:click="encerrar(true)"
                                v-if="atendimento.status === 'encerrando'">
                            {{ 'modal.redirect.button.finish'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# dialog busca #}
        <div id="dialog-busca" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'modal.search'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form class="row" role="form" v-on:submit.prevent="consultar">
                            <div class="col-3">
                                <div class="input-group">
                                    <input type="text" maxlength="10" class="form-search form-control" placeholder="{{ 'modal.search.placeholder'|trans }}" v-model="search">
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-primary" title="{{ 'modal.search.button.submit'|trans }}">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <hr>
                        <div class="result">
                            <table class="table table-hover">
                                <thead>
                                    <tr class="table-primary">
                                        <th>{{ 'label.ticket.number'|trans }}</th>
                                        <th>{{ 'label.service'|trans }}</th>
                                        <th>{{ 'label.priority'|trans }}</th>
                                        <th>{{ 'label.ticket.arrival_date'|trans }}</th>
                                        <th>{{ 'label.ticket.start_date'|trans }}</th>
                                        <th>{{ 'label.ticket.end_date'|trans }}</th>
                                        <th>{{ 'label.triage'|trans }}</th>
                                        <th>{{ 'label.ticket.user'|trans }}</th>
                                        <th>{{ 'label.status'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% verbatim %}
                                        <tr v-for="atendimento in searchResult">
                                            <td>
                                                {{atendimento.senha.format}}
                                            </td>
                                            <td>
                                                {{atendimento.servico.nome}}
                                            </td>
                                            <td>
                                                <span :style="{ 'color': atendimento.prioridade.cor, 'font-weight':  atendimento.prioridade.peso > 0 ? 'bold' : 'normal' }">
                                                    {{atendimento.prioridade.nome}}
                                                </span>
                                            </td>
                                            <td>
                                                <span v-if="atendimento.dataChegada">
                                                    {{moment(atendimento.dataChegada, 'YYYY-MM-DD HH:mm:ss').format(dateTimeFormat)}}
                                                </span>
                                            </td>
                                            <td>
                                                <span v-if="atendimento.dataInicio">
                                                    {{moment(atendimento.dataInicio, 'YYYY-MM-DD HH:mm:ss').format(dateTimeFormat)}}
                                                </span>
                                            </td>
                                            <td>
                                                <span v-if="atendimento.dataFim">
                                                    {{moment(atendimento.dataFim, 'YYYY-MM-DD HH:mm:ss').format(dateTimeFormat)}}
                                                </span>
                                            </td>
                                            <td>
                                                {{atendimento.triagem?.login}}
                                            </td>
                                            <td>
                                                {{atendimento.usuario?.login}}
                                            </td>
                                            <td>
                                                {{atendimento.status}}
                                            </td>
                                        </tr>
                                    {% endverbatim %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# dialog info senha #}
        <div ref="senhaModal" id="dialog-senha" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'label.ticket'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" v-if="atendimentoInfo">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>
                                        {{ 'label.ticket.number'|trans }}
                                    </th>
                                    <td>
                                        {% verbatim %}
                                            {{ atendimentoInfo.senha.format }}
                                        {% endverbatim %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'label.service'|trans }}
                                    </th>
                                    <td>
                                        {% verbatim %}
                                            {{ atendimentoInfo.servico.nome }}
                                        {% endverbatim %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'label.priority'|trans }}
                                    </th>
                                    <td>
                                        {% verbatim %}
                                            {{ atendimentoInfo.prioridade.nome }}
                                        {% endverbatim %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'label.ticket.arrival_date'|trans }}
                                    </th>
                                    <td>
                                        {% verbatim %}
                                            {{moment(atendimentoInfo.dataChegada, 'YYYY-MM-DD HH:mm:ss').format(dateTimeFormat)}}
                                        {% endverbatim %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'label.ticket.wait_time'|trans }}
                                    </th>
                                    <td>
                                        {% verbatim %}
                                            {{ atendimentoInfo.tempoEspera }}
                                        {% endverbatim %}
                                    </td>
                                </tr>
                                <tr>
                                    <th colspan="2">
                                        {{ 'label.customer'|trans }}
                                    </th>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'label.customer.name'|trans }}
                                    </th>
                                    <td>
                                        {% verbatim %}
                                            {{ atendimentoInfo.cliente?.nome }}
                                        {% endverbatim %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        {{ 'label.customer.id'|trans }}
                                    </th>
                                    <td>
                                        {% verbatim %}
                                            {{ atendimentoInfo.cliente?.documento }}
                                        {% endverbatim %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    {% if settings.callTicketOutOfOrder %}
                        <div class="modal-footer">
                            <button class="btn btn-outline-primary"
                                title="{{ 'button.call'|trans }}"
                                v-bind:disabled="busy || !atendimentoInfo || atendimento"
                                v-on:click="chamarAtendimento(atendimentoInfo)">
                                <i class="fa fa-bullhorn"></i>
                                {{ 'button.call'|trans }}
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# dialog de atendimento #}
        <div id="dialog-atendimento-config" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'label.configuration'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3 form-check">
                                    <input id="show-all-services" type="checkbox" class="form-check-input" v-model="config.exibirTodosServicos" v-on:change="saveConfig">
                                    <label for="show-all-services">{{ 'label.configuration.show_all_services'|trans }}</label>
                                </div>
                                <div class="mb-3 form-check">
                                    <input id="show-empty-queue" type="checkbox" class="form-check-input" v-model="config.exibirFilaVazia" v-on:change="saveConfig">
                                    <label for="show-empty-queue">{{ 'label.configuration.show_empty_queue'|trans }}</label>
                                </div>
                                <div class="mb-3">
                                    <label>{{ 'label.configuration.queue_layout'|trans }}</label>
                                    <select class="form-select" v-on:change="saveConfig" v-model="config.layoutFila">
                                        <option value="horizontal">{{ 'label.configuration.queue_layout.horizontal'|trans }}</option>
                                        <option value="vertical">{{ 'label.configuration.queue_layout.vertical'|trans }}</option>
                                    </select>
                                </div>
                                <div v-if="config.layoutFila === 'vertical'" class="mb-3">
                                    <label>{{ 'label.configuration.number_of_columns'|trans }}</label>
                                    <input type="number" class="form-control" min="1" max="6" v-model="config.numeroColunas" v-on:change="saveConfig">
                                </div>
                                <div class="mb-3">
                                    <label>{{ 'label.configuration.select_display_format_label'|trans }}</label>
                                    <select class="form-select" v-model="config.formatoExibicaoSenha" v-on:change="saveConfig">
                                        <option value="ticket">{{ 'label.configuration.option_ticket'|trans }}</option>
                                        <option value="client_name">{{ 'label.configuration.option_client_name'|trans }}</option>
                                        <option value="ticket_client_name">{{ 'label.configuration.option_ticket_client_name'|trans }}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {# som executado quando a fila deixa de estar fazia #}
    <audio id="alert" src="{{ asset('bundles/novosgaattendance/sounds/alert.wav') }}" style="display:none"></audio>
        
    <div id="novosga-clock" title="{{ 'server.datetime'|trans }}" class="clock"></div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link type="text/css" rel="stylesheet" href="{{ asset('bundles/novosgaattendance/css/style.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript">
        const local = {{ local|json_encode|raw }};
        const numeroLocal = {{ numeroLocal ? numeroLocal : 'null' }};
        const usuario = {{ usuario|json_encode()|raw }};
        const unidade = {{ unidade|json_encode()|raw }};
        const atendimento = {{ atendimento|json_encode()|raw }};
        const tipoAtendimento = "{{ tipoAtendimento ? tipoAtendimento : 'null' }}";
        const tiposAtendimento = {{ tiposAtendimento|json_encode()|raw }};
        const settings = {{ settings|json_encode()|raw }};
        const servicosUsuario = {{ servicos|json_encode()|raw }};
        const labelSim = "{{ 'label.yes'|trans }}";
        const labelNao = "{{ 'label.no'|trans }}";
        const dateTimeFormat = "{{ 'MM/DD/YYYY HH:mm:ss'|trans }}";
        const alertTitle = "{{ 'alert.title'|trans }}";
        const alertRedirecionar = "{{ 'alert.ticket_error.text'|trans }}";
        const alertNaoCompareceu = "{{ 'alert.no_show.text'|trans }}";
        const alertEncerrar = "{{ 'alert.finish.text'|trans }}";
        const modalErrorTitle = "{{ 'modal.error'|trans }}"
        const modalErrorText = "{{ 'modal.error.text'|trans }}";
        const notificationTitle = "{{ 'label.attendance'|trans }}";
        const notificationNewAttendance = "{{ 'label.notification.new_attendance'|trans }}";
        const errorSaveCustomer = "{{ 'error.save_customer'|trans }}";
    
        App.Clock.init("novosga-clock", {{ time }}, "{{ unidade.timezone }}");
    </script>
    <script type="text/javascript" src="{{ asset('bundles/novosgaattendance/js/sweetalert.min.js') }}"></script>
    <script src="{{ asset('bundles/novosgaattendance/js/script.js') }}"></script>
{% endblock %}
